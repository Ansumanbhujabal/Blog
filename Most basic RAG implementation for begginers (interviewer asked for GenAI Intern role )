import os  ## used to read file path 
import time
from dotenv import load_dotenv ## to load api keys from env
from langchain_community.document_loaders.pdf import PyPDFDirectoryLoader,PyPDFLoader ## To load and read pdf files 
from langchain_text_splitters.character import CharacterTextSplitter, RecursiveCharacterTextSplitter ## To split the documents in chunks 
from langchain_community.embeddings import HuggingFaceEmbeddings ## To  vectorize the chunks 
from pinecone import Pinecone,ServerlessSpec ## To connect with Pinecone 
from langchain_pinecone import PineconeVectorStore ## To store indexes in PineconeVectorStore
from langchain_groq import ChatGroq ## To load LLM
from langchain.chains.question_answering import load_qa_chain ## To make the question answering chain
import warnings
warnings.filterwarnings('ignore') ## To ignore all warnings coming in the execution

load_dotenv() ## Load all env



## Load api keys 
api_key=os.getenv("PINECONE_API_KEY")
if not api_key:
    raise ValueError("PINECONE_API_KEY is not found")

## Initialize Pinecone 
pc=Pinecone(api_key=api_key)
index_name="practice"  ## Only lowercase allowed in pinecone index

## Initialize LLM

llm= ChatGroq(
    model="llama-3.1-70b-versatile",
    temperature=0
)
## Initialize Chain with LLM
chain=load_qa_chain(llm, chain_type="stuff")

## Load docs 
def read_doc(directory):
    base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    print(f"The base dir is {base_dir}")
    full_path = os.path.join(base_dir, directory)
    print(f"The path dir is {full_path}")    
    if not os.path.exists(full_path):
        raise FileNotFoundError(f"Directory '{directory}' does not exist.")
    file_loader=PyPDFDirectoryLoader(full_path)
    print(file_loader)
    documents=file_loader.load()  ## Load the files from the path 
    return documents

## Chuck documents 
def chunk_data(docs, chunk_size=800, chunk_overlap=80):## Chunk overlap to keep the document parts consistent in every chunk 
    text_splitter=RecursiveCharacterTextSplitter(chunk_size=chunk_size,chunk_overlap=chunk_overlap) ## Recursively chuk the docs w.r.t the overlap
    chunked_docs=text_splitter.split_documents(docs)
    return chunked_docs

# ## Use the 2 functions
doc=read_doc("upload")

# print(f"The doc is {doc}")
chunked_docs=chunk_data(doc)
print(f"The chunked doc is {len(chunked_docs)}")


## Embeddings 
embeddings = HuggingFaceEmbeddings()
embeddings_dimension=768 ## Default weight by Huggingface to avoid any troubles 
print(f"The dimension of embeddings is {embeddings_dimension}")

## Check if Index is already in pinecone otherwise create one 

if index_name not in [index_info["name"] for index_info in pc.list_indexes()]:
    pc.create_index(
        name=index_name,
        dimension=embeddings_dimension,
        metric='cosine',
        spec=ServerlessSpec(cloud='aws',region='us-east-1')
    )
    ## Insert document embeddings into the index 
    index=PineconeVectorStore.from_documents(
        documents= chunked_docs,
        index_name=index_name,
        embedding=embeddings
    )
    pc.describe_index()
    ## Wait for some seconds to connect 
    while not pc.describe_index(index_name).staus["ready"]:
        time.sleep(1)

## Connect to index 
index=pc.Index(index_name)
print(f" The index is connected successfully {index}") 

## Load the vectors from index 
index = PineconeVectorStore.from_existing_index(
    index_name=index_name,
    embedding=embeddings
)
## Retrieve matching documents

def retrieve_query(query,k=2):    ## K is the number of top matching documents to consider 
    matching_result=index.similarity_search(query=query,k=k)  ## Based on cosine similarity of document and query
    return matching_result

## Function to get an answer

def retrieve_answer(query):
    ## Get the matching indexes
    doc_search=retrieve_query(query)
    ## Invoke the chain 
    answer=chain.run(input_documents=doc_search, question=query)
    return answer

if __name__=="__main__":
    ans=retrieve_answer("Tell me what you think about the person  ? ")
    print(ans)

